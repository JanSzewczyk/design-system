{
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "code-quality@szum-tech": true,
    "design@szum-tech": true,
    "performance@szum-tech": true,
    "testing@szum-tech": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "[[ \"$CLAUDE_FILE_PATH\" =~ (node_modules|\\.next|dist|out|\\.claude/) ]] && exit 0; npx --yes @biomejs/biome check --write --no-errors-on-unmatched \"$CLAUDE_FILE_PATH\" 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "[[ \"$TOOL_INPUT\" =~ \"git push\".*\"--force-with-lease\" ]] && exit 0; [[ \"$TOOL_INPUT\" =~ (rm[[:space:]]+-rf[[:space:]]+/|git[[:space:]]+push.*--force([[:space:]]|$)|drop[[:space:]]+database) ]] && echo 'Dangerous command blocked' >&2 && exit 2 || true",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "echo '🚀 Session started in: $CLAUDE_PROJECT_DIR' >&2",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "echo '✅ Session complete in: $CLAUDE_PROJECT_DIR' >&2",
            "type": "command"
          }
        ]
      }
    ]
  }
}
