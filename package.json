{
  "name": "@szum-tech/design-system",
  "version": "3.21.9",
  "description": "Szum-Tech design system with tailwindcss support",
  "keywords": [
    "szum-tech",
    "Szum-Tech",
    "tailwindcss",
    "react",
    "javascript",
    "theme",
    "typescript",
    "react-components",
    "storybook",
    "design-system",
    "semantic-release"
  ],
  "homepage": "https://github.com/JanSzewczyk/design-system#readme",
  "bugs": {
    "url": "https://github.com/JanSzewczyk/design-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanSzewczyk/design-system.git"
  },
  "license": "MIT",
  "author": "Jan Szewczyk (Szum-Tech)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/components/index.d.ts",
        "import": "./dist/components/index.js"
      },
      "require": {
        "types": "./dist/components/index.d.cts",
        "require": "./dist/components/index.cjs"
      }
    },
    "./components/*": {
      "import": {
        "types": "./dist/components/*/index.d.ts",
        "import": "./dist/components/*/index.js"
      },
      "require": {
        "types": "./dist/components/*/index.d.cts",
        "require": "./dist/components/*/index.cjs"
      }
    },
    "./icons": {
      "import": {
        "types": "./dist/icons/index.d.ts",
        "import": "./dist/icons/index.js"
      },
      "require": {
        "types": "./dist/icons/index.d.cts",
        "require": "./dist/icons/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils/index.d.ts",
        "import": "./dist/utils/index.js"
      },
      "require": {
        "types": "./dist/utils/index.d.cts",
        "require": "./dist/utils/index.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks/index.d.ts",
        "import": "./dist/hooks/index.js"
      },
      "require": {
        "types": "./dist/hooks/index.d.cts",
        "require": "./dist/hooks/index.cjs"
      }
    },
    "./tailwind/*.css": "./tailwind/*.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/components/index.cjs",
  "module": "./dist/components/index.js",
  "types": "./dist/components/index.d.ts",
  "files": [
    "dist/**",
    "tailwind/**"
  ],
  "scripts": {
    "biome:check": "biome check .",
    "biome:ci": "biome ci --reporter=github",
    "biome:fix": "biome check --write .",
    "biome:format": "biome format .",
    "biome:format:fix": "biome format --write .",
    "biome:lint": "biome lint .",
    "biome:lint:fix": "biome lint --write .",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsup && cpy \"src/tailwind/*.css\" \"./tailwind\" --flat && npm run post-build",
    "knip": "knip",
    "knip:ci": "knip --reporter github-actions",
    "post-build": "node src/scripts/post-build.ts",
    "storybook:build": "storybook build --docs",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:serve": "serve storybook-static",
    "test": "vitest",
    "test:ci": "CI=true vitest --coverage",
    "test:coverage": "vitest --coverage",
    "test:storybook": "vitest --project=storybook --coverage",
    "test:ui": "vitest --ui",
    "test:unit": "vitest --project=unit --coverage",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-compose-refs": "^1.1.5",
    "@radix-ui/react-direction": "^1.1.5",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "radix-ui": "^1.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@storybook-community/storybook-dark-mode": "^7.1.4",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/builder-vite": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@szum-tech/semantic-release-config": "^2.3.7",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "happy-dom": "^20.14.6",
    "knip": "^6.41.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-docgen": "^8.0.4",
    "react-dom": "^19.3.0",
    "semantic-release": "^25.0.6",
    "serve": "^14.2.6",
    "storybook": "^10.6.1",
    "storybook-addon-tag-badges": "^3.1.0",
    "tailwindcss": "^4.3.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
